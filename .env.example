# Elastic Cloud (Hosted or Serverless) — endpoint + API key from the Connection Details page
ELASTIC_ENDPOINT=https://your-project.es.region.aws.elastic.cloud
ELASTIC_API_KEY=your-elastic-api-key

# Kibana endpoint, for the Agent Builder API (chat panel + scripts/setup_agent.py).
# Cloud Hosted: Deployment page -> Kibana "Copy endpoint". It has .kb. in the host.
KIBANA_URL=https://your-deployment.kb.region.gcp.elastic-cloud.com

# The Odds API — https://the-odds-api.com/
ODDS_API_KEY=your-odds-api-key
